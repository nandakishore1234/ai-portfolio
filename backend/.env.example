# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.

# --- Ollama (chat + embeddings) ---
# ollama pull qwen2
# ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Qdrant vector store ---
# Embedded local store (no Docker): keep QDRANT_PATH set.
# Server mode: leave QDRANT_PATH empty and use QDRANT_URL.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nanda_portfolio
QDRANT_PATH=qdrant

# --- RAG ---
RAG_TOP_K=6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Contact form email ---
# Inbox that receives form submissions.
CONTACT_TO_EMAIL=knandakishore6@gmail.com

# Option A: Resend (preferred if you have a key)
# https://resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Option B: Gmail SMTP (use an App Password, not your normal password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- LiveKit voice (local) ---
# Dev defaults match livekit.yaml / scripts/livekit.yaml
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
# Must be >= 32 characters (LiveKit server requirement).
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecret12
LIVEKIT_ROOM_PREFIX=nanda-voice

# Faster-Whisper STT (local). Use cpu + int8 on machines without CUDA.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Piper TTS (local). Download en_US-ryan-high.onnx + .onnx.json into this folder.
PIPER_MODEL_PATH=data/piper/en_US-ryan-high.onnx
PIPER_SPEED=1.0
# How many voice job processes to keep ready for concurrent callers.
VOICE_IDLE_PROCESSES=2

# --- Admin login at /admin ---
ADMIN_USERNAME=nandu
ADMIN_PASSWORD=nandu123
ADMIN_SECRET=change-this-to-a-long-random-jwt-secret

# --- SeaweedFS (call recordings, Windows without Docker) ---
# powershell -ExecutionPolicy Bypass -File scripts/download_seaweedfs.ps1
# .\bin\weed.exe server -dir=./data/seaweed -filer -s3 -ip=127.0.0.1
SEAWEEDFS_FILER_URL=http://127.0.0.1:8888
SEAWEEDFS_PREFIX=/nanda-calls

# --- PostgreSQL (one assets row per mixed call recording) ---
DATABASE_URL=postgresql://nandu:nandu123@127.0.0.1:5432/nanda_port

# --- Gemini LLM (chat + voice RAG). If empty, Ollama is used. ---
# Put 1–5 keys. On quota/auth failure the next key is tried.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Or a comma-separated list:
# GEMINI_API_KEYS=key1,key2,key3

# --- Cartesia STT + TTS. If empty, local Whisper + Piper are used. ---
CARTESIA_STT_MODEL=ink-2
CARTESIA_STT_LANGUAGE=en
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_TTS_LANGUAGE=en
CARTESIA_TTS_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_TTS_VOICE_ID_1=
CARTESIA_TTS_VOICE_ID_2=
CARTESIA_TTS_VOICE_ID_3=
CARTESIA_TTS_VOICE_ID_4=
CARTESIA_TTS_VOICE_ID_5=
CARTESIA_TTS_SPEED=1.0
CARTESIA_API_KEY_1=
CARTESIA_API_KEY_2=
CARTESIA_API_KEY_3=
CARTESIA_API_KEY_4=
CARTESIA_API_KEY_5=
# Or a comma-separated list:
# CARTESIA_API_KEYS=key1,key2,key3
