# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.

# --- Ollama (chat + embeddings) ---
# ollama pull qwen2
# ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Qdrant vector store ---
# Embedded local store (no Docker): keep QDRANT_PATH set.
# Server mode: leave QDRANT_PATH empty and use QDRANT_URL.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nanda_portfolio
QDRANT_PATH=qdrant

# --- RAG ---
RAG_TOP_K=6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Contact form email ---
# Inbox that receives form submissions.
CONTACT_TO_EMAIL=knandakishore6@gmail.com

# Option A: Resend (preferred if you have a key)
# https://resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Option B: Gmail SMTP (use an App Password, not your normal password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
